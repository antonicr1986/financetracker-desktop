<UserControl x:Class="FinanceTracker.Desktop.Controls.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <!-- El ojo: sin fondo ni borde, solo el icono. Al pasar el raton se
             oscurece, como en la web. -->
        <Style x:Key="EyeToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Content" Value="&#xE7B3;" />
            <Setter Property="ToolTip" Value="{DynamicResource password.show}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </Trigger>
                <!-- Visible: ojo tachado y "Ocultar". -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="&#xED1A;" />
                    <Setter Property="ToolTip" Value="{DynamicResource password.hide}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- El hueco de la derecha (Padding) deja sitio al ojo. -->
        <PasswordBox x:Name="HiddenInput" Padding="6,6,34,6" PasswordChanged="OnHiddenChanged" />
        <TextBox x:Name="VisibleInput" Padding="6,6,34,6" Visibility="Collapsed" TextChanged="OnVisibleChanged" />
        <ToggleButton x:Name="EyeButton" Style="{StaticResource EyeToggle}" Width="32"
                      HorizontalAlignment="Right" Margin="0,1,1,1"
                      Checked="OnEyeChanged" Unchecked="OnEyeChanged" />
    </Grid>
</UserControl>
