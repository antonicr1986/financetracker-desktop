<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Runtimes para los que se restauran paquetes. El proyecto de empaquetado
         MSIX (FinanceTracker.Desktop.Package) publica para cada uno y necesita
         que NuGet haya generado su project.assets.json de antemano. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Permite restaurar el proyecto en Linux. No cambia nada en Windows; lo
         necesita el envio automatico de dependencias de GitHub, que corre en
         un runner Linux y, con los RuntimeIdentifiers de arriba, tiene que
         descargar los paquetes de Windows aunque no vaya a compilar. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Icono del .exe: explorador de archivos y barra de tareas. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Ajustes de Windows para el .exe (reconocimiento de PPP por monitor). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Version de la app: la muestra la pantalla de acceso. El release la
         sobrescribe con la de la etiqueta (-p:Version); se mantiene igual a
         la ultima etiqueta para que una compilacion local muestre lo mismo. -->
    <Version>1.4.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tambien como recurso, para que las ventanas lo usen en la barra de titulo. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Inicio de sesion con Google en apps de escritorio (navegador + puerto local). -->
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Secreto del cliente de Google de escritorio: no esta en el repo. MSBuild
         lee la variable de entorno GOOGLE_DESKTOP_CLIENT_SECRET (en la release,
         un secret de GitHub) y la deja en el ensamblado. Ver GoogleSignIn.cs. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GoogleDesktopClientSecret</_Parameter1>
      <_Parameter2>$(GOOGLE_DESKTOP_CLIENT_SECRET)</_Parameter2>
    </AssemblyAttribute>
    <!-- DPAPI: cifra la sesion guardada con una clave de la cuenta de Windows. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
