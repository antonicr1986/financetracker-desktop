<Window x:Class="FinanceTracker.Desktop.Views.TransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.Desktop.ViewModels"
        xmlns:controls="clr-namespace:FinanceTracker.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TransactionEditorViewModel}"
        Title="{Binding Title}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}">

    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Tipo: dos RadioButton enlazados a propiedades opuestas del ViewModel. -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton Content="{DynamicResource dialog.expense}" IsChecked="{Binding IsExpense}" Margin="0,0,16,0" />
            <RadioButton Content="{DynamicResource dialog.income}" IsChecked="{Binding IsIncome}" />
        </StackPanel>

        <TextBlock Text="{DynamicResource dialog.concept}" Margin="0,0,0,4" />
        <TextBox x:Name="DescriptionInput"
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"
                 controls:Hint.Text="{DynamicResource dialog.conceptPlaceholder}" Margin="0,0,0,12" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource dialog.amount}" Margin="0,0,0,4" />
                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource dialog.date}" Margin="0,0,0,4" />
                <DatePicker SelectedDate="{Binding Date}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{DynamicResource dialog.category}" Margin="0,0,0,4" />
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                  DisplayMemberPath="Name" />

        <TextBlock Text="{DynamicResource dialog.noCategoriesOfType}" Style="{StaticResource MutedText}"
                   TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding HasNoCategoriesOfType, Converter={StaticResource BoolToVisibility}}" />

        <!-- Categoria nueva, como en la web: un enlace que abre una caja con
             Añadir y Cancelar. Se crea del tipo elegido arriba. -->
        <Button Content="{DynamicResource dialog.newCategory}" Command="{Binding StartAddingCategoryCommand}"
                Style="{StaticResource LinkButton}" Margin="0,8,0,12"
                Visibility="{Binding ShowNewCategoryLink, Converter={StaticResource BoolToVisibility}}" />

        <Grid Margin="0,8,0,12"
              Visibility="{Binding IsAddingCategory, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewCategoryInput" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="100" controls:Hint.Text="{DynamicResource dialog.newCategoryPlaceholder}" />
            <!-- Mientras se escribe la categoria, Enter la crea: Añadir pasa a ser
                 el boton por defecto y Guardar deja de serlo (mas abajo). Si no,
                 Enter guardaria el movimiento a medias. -->
            <Button Grid.Column="1" Content="{DynamicResource dialog.add}" Command="{Binding CreateCategoryCommand}"
                    IsDefault="{Binding IsAddingCategory}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="{DynamicResource dialog.cancel}" Command="{Binding CancelAddingCategoryCommand}"
                    Margin="8,0,0,0" />
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <DockPanel>
            <!-- Borrar solo existe al editar. -->
            <Button DockPanel.Dock="Left" Content="{DynamicResource dialog.delete}" Command="{Binding DeleteCommand}"
                    Style="{StaticResource DangerButton}"
                    Visibility="{Binding IsEdit, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- IsCancel: el propio WPF cierra el dialogo con Escape o al
                     pulsarlo, sin comando. IsDefault: Enter guarda. -->
                <Button Content="{DynamicResource dialog.cancel}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="{DynamicResource dialog.save}" Command="{Binding SaveCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <!-- Enter guarda, salvo mientras se escribe una categoria nueva. -->
                            <Setter Property="IsDefault" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddingCategory}" Value="True">
                                    <Setter Property="IsDefault" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
