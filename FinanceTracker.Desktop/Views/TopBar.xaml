<!-- Barra superior comun a todas las ventanas, como la de la web y Android:
     nombre a la izquierda; idioma, tema y "Salir" a la derecha. "Salir"
     siempre esta, pero deshabilitado sin sesion.

     Es ademas la barra de titulo de la ventana (WindowChrome, en cada
     Window): se arrastra para mover la ventana y lleva los botones de
     minimizar, maximizar y cerrar. Su altura (56) tiene que coincidir con el
     CaptionHeight de las ventanas. -->
<UserControl x:Class="FinanceTracker.Desktop.Views.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1" Height="56">
        <DockPanel>
            <!-- Botones de la ventana, pegados al borde y de toda la altura. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="OnMaximizeClick" />
                <Button Style="{StaticResource CloseCaptionButton}"
                        Content="&#xE8BB;" Click="OnCloseClick" />
            </StackPanel>

            <DockPanel Margin="24,0,16,0">
            <!-- IsHitTestVisibleInChrome: sin esto, estos controles contarian como
                 barra de titulo y el clic arrastraria la ventana. -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">

                <!-- Idioma: dos botones y no un desplegable, como la web: con dos
                     opciones, un desplegable esconde lo que cabe a la vista. -->
                <!-- Padding 2: el boton activo queda como una pastilla redondeada
                     dentro del marco, sin tapar sus esquinas. -->
                <Border BorderBrush="{DynamicResource Brush.InputBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="2" Margin="0,0,12,0" VerticalAlignment="Center"
                        ToolTip="{DynamicResource locale.label}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SpanishButton" Style="{StaticResource SegmentButton}"
                                Click="OnSpanishClick" ToolTip="{DynamicResource locale.es}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Banderas dibujadas, como Flag.tsx: Windows no trae
                                     fuente para los emoji de bandera. -->
                                <Viewbox Width="16" Height="11" Margin="0,0,6,0">
                                    <Canvas Width="12" Height="8">
                                        <Rectangle Width="12" Height="8" Fill="#AA151B" />
                                        <Rectangle Canvas.Top="2" Width="12" Height="4" Fill="#F1BF00" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="ES" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EnglishButton" Style="{StaticResource SegmentButton}"
                                Click="OnEnglishClick" ToolTip="{DynamicResource locale.en}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="11" Margin="0,0,6,0">
                                    <Canvas Width="12" Height="8">
                                        <Rectangle Width="12" Height="8" Fill="#FFFFFF" />
                                        <Rectangle Canvas.Top="0" Width="12" Height="1" Fill="#B31942" />
                                        <Rectangle Canvas.Top="2" Width="12" Height="1" Fill="#B31942" />
                                        <Rectangle Canvas.Top="4" Width="12" Height="1" Fill="#B31942" />
                                        <Rectangle Canvas.Top="6" Width="12" Height="1" Fill="#B31942" />
                                        <Rectangle Width="5" Height="4" Fill="#0A3161" />
                                        <Ellipse Canvas.Left="0.6" Canvas.Top="0.6" Width="0.8" Height="0.8" Fill="White" />
                                        <Ellipse Canvas.Left="2.6" Canvas.Top="0.6" Width="0.8" Height="0.8" Fill="White" />
                                        <Ellipse Canvas.Left="1.6" Canvas.Top="1.6" Width="0.8" Height="0.8" Fill="White" />
                                        <Ellipse Canvas.Left="0.6" Canvas.Top="2.6" Width="0.8" Height="0.8" Fill="White" />
                                        <Ellipse Canvas.Left="2.6" Canvas.Top="2.6" Width="0.8" Height="0.8" Fill="White" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="EN" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Click="OnThemeClick"
                        Margin="0,0,12,0" ToolTip="{DynamicResource theme.toggle}" VerticalAlignment="Center">
                    <Grid Width="16" Height="16">
                        <!-- Los mismos trazados SVG que ThemeToggle.tsx de la web.
                             Cual se ve lo decide el tema (Visibility.Moon/Sun), no el codigo.
                             Viewbox + Canvas de 24x24: el mismo viewBox del SVG, asi
                             la luna y el sol salen del mismo tamaño. -->
                        <Viewbox Visibility="{DynamicResource Visibility.Moon}">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{Binding Foreground, ElementName=ThemeButton}" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox Visibility="{DynamicResource Visibility.Sun}">
                            <Canvas Width="24" Height="24">
                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8"
                                         Stroke="{Binding Foreground, ElementName=ThemeButton}" StrokeThickness="2" />
                                <Path Stroke="{Binding Foreground, ElementName=ThemeButton}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>

                <!-- Ancho fijo, como en Android: no cambia entre "Salir" y "Sign out". -->
                <Button x:Name="SignOutButton" Content="{DynamicResource header.signOut}" MinWidth="88"
                        VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Sin IsHitTestVisibleInChrome: el logo y el nombre son barra de
                     titulo, asi que desde aqui se arrastra la ventana. -->
                <!-- El mismo logo que el icono de la app, dibujado en vectorial para que
                     se vea nitido a cualquier escala. Es el vector de Android
                     (ic_launcher_foreground.xml): tres barras con extremos redondeados,
                     la mas alta en el verde de ingresos. -->
                <Viewbox Width="22" Height="22" Margin="0,0,8,0">
                    <Canvas Width="72" Height="72">
                        <Rectangle Width="72" Height="72" RadiusX="16" RadiusY="16" Fill="#0F172A" />
                        <Line X1="18" Y1="44" X2="18" Y2="60" Stroke="#E2E8F0" StrokeThickness="12"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="36" Y1="34" X2="36" Y2="60" Stroke="#E2E8F0" StrokeThickness="12"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="54" Y1="20" X2="54" Y2="60" Stroke="#34D399" StrokeThickness="12"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="FinanceTracker" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
