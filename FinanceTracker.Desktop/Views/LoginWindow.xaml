<Window x:Class="FinanceTracker.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.Desktop.ViewModels"
        xmlns:views="clr-namespace:FinanceTracker.Desktop.Views"
        xmlns:controls="clr-namespace:FinanceTracker.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="{DynamicResource login.windowTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}">

    <DockPanel>
        <!-- Sin SignOutCommand: "Salir" aparece deshabilitado, como en la web. -->
        <views:TopBar DockPanel.Dock="Top" />

        <StackPanel Margin="24">
            <!-- Titulo fuera de la tarjeta y formulario dentro, como la web y Android. -->
            <TextBlock Text="{DynamicResource login.title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource login.email}" Margin="0,0,0,4" />
                    <!-- UpdateSourceTrigger=PropertyChanged: el ViewModel se entera en
                         cada tecla, no solo al salir de la caja. Hint.Text: el texto de
                         ayuda con la caja vacia (Controls/Hint.cs). -->
                    <TextBox x:Name="EmailInput" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             controls:Hint.Text="{DynamicResource login.emailPlaceholder}" Margin="0,0,0,12" />

                    <TextBlock Text="{DynamicResource login.password}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged"
                                 controls:Hint.Text="{DynamicResource login.passwordPlaceholder}" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Error}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <!-- IsDefault: Enter en cualquier caja pulsa este boton. -->
                    <Button Content="{DynamicResource login.submit}" Command="{Binding LoginCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="0,9" />

                    <TextBlock Text="{DynamicResource login.connecting}"
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Separador con texto en medio: "—— o ——" -->
                    <Grid Margin="0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Separator VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource login.or}" Style="{StaticResource MutedText}" Margin="12,0" />
                        <Separator Grid.Column="2" VerticalAlignment="Center" />
                    </Grid>

                    <Button Content="{DynamicResource login.demo}" Command="{Binding LoginDemoCommand}"
                            Padding="0,9" />
                    <TextBlock Text="{DynamicResource login.demoHint}"
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
