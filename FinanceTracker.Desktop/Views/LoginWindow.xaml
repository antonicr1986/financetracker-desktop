<Window x:Class="FinanceTracker.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="FinanceTracker — Iniciar sesión"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="32">
        <TextBlock Text="Iniciar sesión" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />

        <TextBlock Text="Email" Margin="0,0,0,4" />
        <!-- UpdateSourceTrigger=PropertyChanged: el ViewModel se entera en cada
             tecla, no solo al salir de la caja. -->
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6" Margin="0,0,0,12" />

        <TextBlock Text="Contraseña" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged"
                     Padding="6" Margin="0,0,0,12" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#E11D48"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <!-- IsDefault: Enter en cualquier caja pulsa este boton. -->
        <Button Content="Entrar" Command="{Binding LoginCommand}" IsDefault="True"
                Padding="0,8" />

        <TextBlock Text="Conectando… la primera vez del día puede tardar un poco."
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                   Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0" />

        <Separator Margin="0,20" />

        <TextBlock Foreground="Gray" TextWrapping="Wrap">
            <Run Text="Cuenta de demostración:" />
            <Run Text="{x:Static vm:LoginViewModel.DemoEmail}" FontWeight="SemiBold" />
            <Run Text="/" />
            <Run Text="{x:Static vm:LoginViewModel.DemoPassword}" FontWeight="SemiBold" />
        </TextBlock>
    </StackPanel>
</Window>
