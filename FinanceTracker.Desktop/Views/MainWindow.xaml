<Window x:Class="FinanceTracker.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="FinanceTracker" Height="680" Width="960" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#E2E8F0">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Colores de la web: slate para lo neutro, emerald ingresos, rose gastos. -->
        <SolidColorBrush x:Key="Income" Color="#059669" />
        <SolidColorBrush x:Key="Expense" Color="#E11D48" />
        <SolidColorBrush x:Key="Muted" Color="#64748B" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Barra superior blanca, como la web. -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1" Padding="24,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Salir" Command="{Binding LogoutCommand}"
                        Padding="16,6" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Email}" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Selector de mes y recarga -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Recargar" Command="{Binding LoadCommand}"
                        Padding="12,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mes" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}"
                              DisplayMemberPath="Label" Width="200" />
                </StackPanel>
            </DockPanel>

            <!-- Totales del mes -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16"
                         Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Ingresos" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding IncomeText}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource Income}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Gastos" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ExpenseText}" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource Expense}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Balance" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding BalanceText}" FontSize="22" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0F172A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBalanceNegative}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Expense}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Movimientos del mes -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">
                <ListView ItemsSource="{Binding Transactions}" BorderThickness="0"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TransactionRow}">
                            <Grid Margin="12,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{StaticResource Muted}">
                                        <Run Text="{Binding Category, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding DateText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="16,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Expense}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Income}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Estados: cargando, error, sin datos -->
            <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Cargando movimientos… la primera vez del día puede tardar un poco."
                           Foreground="{StaticResource Muted}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Expense}"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Button Content="Reintentar" Command="{Binding LoadCommand}"
                            Padding="16,6" HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Todavía no tienes movimientos." Foreground="{StaticResource Muted}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
