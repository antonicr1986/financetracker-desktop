<Window x:Class="FinanceTracker.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.Desktop.ViewModels"
        xmlns:views="clr-namespace:FinanceTracker.Desktop.Views"
        xmlns:controls="clr-namespace:FinanceTracker.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="FinanceTracker" Height="680" Width="960" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}">

    <!-- La barra de titulo de Windows se sustituye por nuestra barra superior
         (TopBar), para no ver "FinanceTracker" dos veces.
         CaptionHeight: los 56 de arriba se comportan como barra de titulo
         (arrastrar, doble clic, ajustar a los bordes). GlassFrameThickness con
         1 abajo: Windows sigue dibujando la sombra de la ventana.
         UseAeroCaptionButtons=False: los botones los pone TopBar. -->
    <Window.Resources>
        <controls:PercentToHeightConverter x:Key="PercentToHeight" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <views:TopBar DockPanel.Dock="Top" SignOutCommand="{Binding LogoutCommand}" SettingsCommand="{Binding OpenMfaCommand}" />

        <!-- Se desplaza toda la pantalla, no solo la lista, como en Android: con
             presupuestos y desglose, una lista de altura fija quedaria diminuta. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- Saludo y correo -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{Binding Greeting}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Email}" Style="{StaticResource MutedText}" />
                </StackPanel>

                <!-- Selector de mes y acciones -->
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{DynamicResource dashboard.reload}" Command="{Binding LoadCommand}" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource dashboard.newTransactionButton}" Command="{Binding NewTransactionCommand}"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource table.month}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}"
                                  DisplayMemberPath="Label" Width="200" />
                    </StackPanel>
                </DockPanel>

                <!-- Estados: cargando, error, sin datos -->
                <StackPanel HorizontalAlignment="Center" Margin="0,48,0,0">
                    <TextBlock Text="{DynamicResource dashboard.loading}" Style="{StaticResource MutedText}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Error}"
                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <Button Content="{DynamicResource dashboard.retry}" Command="{Binding LoadCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource dashboard.emptyTitle}" Style="{StaticResource MutedText}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <!-- Con datos, este hueco no ocupa espacio. -->
                                <DataTrigger Binding="{Binding HasData}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>

                <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}">

                    <!-- Totales del mes -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dashboard.income}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding IncomeText}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Income}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dashboard.expenses}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding ExpenseText}" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Expense}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource dashboard.balance}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding BalanceText}" FontSize="22" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBalanceNegative}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Expense}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Presupuestos y desglose, uno al lado del otro: en escritorio
                         sobra ancho y asi la lista de movimientos queda mas arriba. -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- ===== Presupuestos ===== -->
                        <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                            <StackPanel>
                                <Button Style="{StaticResource SectionHeader}" Command="{Binding ToggleBudgetsCommand}"
                                        ToolTip="{DynamicResource section.toggle}">
                                    <DockPanel>
                                        <!-- Flecha: hacia abajo plegada, hacia arriba abierta. -->
                                        <Path DockPanel.Dock="Right" Data="M0,0 L5,5 L10,0" VerticalAlignment="Center"
                                              Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBudgetsExpanded}" Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource budgets.title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding BudgetsSummary}" Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <!-- Margen 8 y no 16: cada fila es un boton con 8 de relleno propio,
                                     asi el texto sigue alineado con la cabecera. -->
                                <StackPanel Margin="8,0,8,12"
                                            Visibility="{Binding IsBudgetsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{DynamicResource budgets.empty}" TextWrapping="Wrap" Margin="8,0,8,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasBudgets}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding BudgetRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BudgetRow}">
                                                <!-- Cada presupuesto se pulsa para editarlo. El comando esta en
                                                     el ViewModel de la ventana: se busca subiendo al ItemsControl. -->
                                                <Button Style="{StaticResource RowButton}" Margin="0,0,0,4"
                                                        ToolTip="{Binding EditHint}"
                                                        Command="{Binding DataContext.EditBudgetCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <!-- El color sigue al tono: verde, ambar al 80 %, rojo al 100 %. -->
                                                    <StackPanel.Resources>
                                                        <Style x:Key="ToneText" TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Income}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Over">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Expense}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Resources>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}"
                                                                   FontWeight="SemiBold" Style="{StaticResource ToneText}" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding CategoryText}" Style="{StaticResource MutedText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar Value="{Binding BarValue, Mode=OneWay}" Margin="0,6">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.BarOk}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.BarWarning}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="Over">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.BarOver}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                                                   Style="{StaticResource ToneText}" />
                                                        <TextBlock Text="{Binding SpentOfText}" Style="{StaticResource MutedText}" />
                                                    </DockPanel>
                                                </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{DynamicResource budgets.new}" Command="{Binding NewBudgetCommand}"
                                            HorizontalAlignment="Left" Margin="8,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== Gastos por categoria ===== -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                            <StackPanel>
                                <Button Style="{StaticResource SectionHeader}" Command="{Binding ToggleBreakdownCommand}"
                                        ToolTip="{DynamicResource section.toggle}">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Right" Data="M0,0 L5,5 L10,0" VerticalAlignment="Center"
                                              Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBreakdownExpanded}" Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource dashboard.byCategory}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding BreakdownSummary}" Style="{StaticResource MutedText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>

                                <StackPanel Margin="16,0,16,16"
                                            Visibility="{Binding IsBreakdownExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{DynamicResource dashboard.noExpensesThisMonth}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasExpenses}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding BreakdownRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:BreakdownRow}">
                                                <StackPanel Margin="0,4,0,8">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <!-- Sin tonos: aqui no hay limite que superar, solo un reparto. -->
                                                    <ProgressBar Value="{Binding BarValue, Mode=OneWay}" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== Evolucion mensual =====
                         Todo el historico, con el mes elegido resaltado. Dibujado con
                         controles WPF, como la web y las barras del desglose: sin
                         libreria de graficos. -->
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                        <StackPanel>
                            <Button Style="{StaticResource SectionHeader}" Command="{Binding ToggleTrendCommand}"
                                    ToolTip="{DynamicResource section.toggle}">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="M0,0 L5,5 L10,0" VerticalAlignment="Center"
                                          Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTrendExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource dashboard.monthlyTrend}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TrendSummary}" Style="{StaticResource MutedText}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <StackPanel Margin="16,0,16,16"
                                        Visibility="{Binding IsTrendExpanded, Converter={StaticResource BoolToVisibility}}">
                                <!-- Leyenda -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                               Fill="{DynamicResource Brush.Income}" />
                                    <TextBlock Text="{DynamicResource dashboard.income}" Style="{StaticResource MutedText}"
                                               Margin="6,0,16,0" />
                                    <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                               Fill="{DynamicResource Brush.Expense}" />
                                    <TextBlock Text="{DynamicResource dashboard.expenses}" Style="{StaticResource MutedText}"
                                               Margin="6,0,0,0" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Eje vertical: tope, mitad y 0 -->
                                    <Grid Margin="0,0,8,0">
                                        <TextBlock Text="{Binding TrendTicks[0]}" Style="{StaticResource MutedText}" FontSize="11"
                                                   VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-7,0,0" />
                                        <TextBlock Text="{Binding TrendTicks[1]}" Style="{StaticResource MutedText}" FontSize="11"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding TrendTicks[2]}" Style="{StaticResource MutedText}" FontSize="11"
                                                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,-7" />
                                    </Grid>

                                    <!-- Lineas de referencia -->
                                    <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" />
                                    <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                                            VerticalAlignment="Center" />

                                    <!-- Barras: un hueco por mes; el raton encima muestra los importes. -->
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding TrendBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TrendBar}">
                                                <Border ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="150">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                                VerticalAlignment="Bottom">
                                                        <Border Width="12" Margin="0,0,3,0" CornerRadius="3,3,0,0" VerticalAlignment="Bottom"
                                                                Background="{DynamicResource Brush.Income}"
                                                                Height="{Binding IncomeHeight, Converter={StaticResource PercentToHeight}, ConverterParameter=160}" />
                                                        <Border Width="12" CornerRadius="3,3,0,0" VerticalAlignment="Bottom"
                                                                Background="{DynamicResource Brush.Expense}"
                                                                Height="{Binding ExpenseHeight, Converter={StaticResource PercentToHeight}, ConverterParameter=160}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Eje horizontal: el mes elegido en negrita -->
                                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TrendBars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TrendBar}">
                                                <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,6,0,0"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Movimientos del mes -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <ListView ItemsSource="{Binding Transactions}">
                            <!-- Sin ScrollViewer propio: desplaza la pantalla entera. Con uno
                                 dentro de otro, la rueda del raton se quedaria en la lista. -->
                            <ListView.Template>
                                <ControlTemplate TargetType="ListView">
                                    <ItemsPresenter Margin="4" />
                                </ControlTemplate>
                            </ListView.Template>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TransactionRow}">
                                    <!-- Doble clic abre el movimiento para editarlo. El comando
                                         esta en el ViewModel de la ventana, no en la fila, asi que
                                         se busca subiendo hasta el ListView. Background Transparent
                                         hace que el clic cuente en toda la fila, no solo en el texto. -->
                                    <Grid Margin="12,8" Background="Transparent">
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.EditTransactionCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ListView}}"
                                                          CommandParameter="{Binding}" />
                                        </Grid.InputBindings>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}">
                                                <Run Text="{Binding Category, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding DateText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="16,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Expense}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncome}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Income}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
