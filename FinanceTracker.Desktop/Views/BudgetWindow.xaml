<Window x:Class="FinanceTracker.Desktop.Views.BudgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.Desktop.ViewModels"
        xmlns:controls="clr-namespace:FinanceTracker.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BudgetEditorViewModel}"
        Title="{Binding Title}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}">

    <!-- Una sola barra, como el formulario de movimiento: la fila del titulo se
         arrastra y lleva la X. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <StackPanel>
            <DockPanel Height="64">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" VerticalAlignment="Top"
                        Height="40" Content="&#xE8BB;" Click="OnCloseClick" />
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Bottom" Margin="24,0,0,4" />
            </DockPanel>

            <StackPanel Margin="24,12,24,24">
                <TextBlock Text="{DynamicResource budgets.name}" Margin="0,0,0,4" />
                <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                         controls:Hint.Text="{DynamicResource budgets.namePlaceholder}" Margin="0,0,0,12" />

                <!-- Tipo: el presupuesto limita gastos o ingresos de ese tipo. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton Content="{DynamicResource dialog.expense}" IsChecked="{Binding IsExpense}" Margin="0,0,16,0" />
                    <RadioButton Content="{DynamicResource dialog.income}" IsChecked="{Binding IsIncome}" />
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource dialog.amount}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource budgets.month}" Margin="0,0,0,4" />
                        <!-- 12 meses antes y 12 despues, como Android. -->
                        <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}"
                                  DisplayMemberPath="Label" MaxDropDownHeight="300" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource dialog.category}" Margin="0,0,0,4" />
                <!-- "Todas las categorías" primero: cuenta todo el tipo. -->
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" Margin="0,0,0,12" />

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap"
                           Margin="0,0,0,12"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="{DynamicResource dialog.delete}" Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButton}"
                            Visibility="{Binding IsEdit, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{DynamicResource dialog.cancel}" IsCancel="True" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource dialog.save}" Command="{Binding SaveCommand}" IsDefault="True"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
