<Window x:Class="FinanceTracker.Desktop.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.Desktop.ViewModels"
        xmlns:views="clr-namespace:FinanceTracker.Desktop.Views"
        xmlns:controls="clr-namespace:FinanceTracker.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RegisterViewModel}"
        Title="{DynamicResource register.windowTitle}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}">

    <!-- Una sola barra, como el login: la TopBar hace de barra de titulo. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <!-- Sin sesion: "Salir" deshabilitado, como en el login. -->
        <views:TopBar DockPanel.Dock="Top" />

        <StackPanel Margin="24">
            <!-- Titulo y subtitulo fuera de la tarjeta, como la web y Android. -->
            <TextBlock Text="{DynamicResource register.title}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource register.subtitle}" Style="{StaticResource MutedText}" Margin="0,2,0,16" />

            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource register.name}" Margin="0,0,0,4" />
                    <TextBox x:Name="NameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"
                             controls:Hint.Text="{DynamicResource register.namePlaceholder}" Margin="0,0,0,12" />

                    <TextBlock Text="{DynamicResource login.email}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"
                             controls:Hint.Text="{DynamicResource login.emailPlaceholder}" Margin="0,0,0,12" />

                    <TextBlock Text="{DynamicResource login.password}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged"
                                 controls:Hint.Text="{DynamicResource register.passwordPlaceholder}" Margin="0,0,0,12" />

                    <TextBlock Text="{DynamicResource register.confirm}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="ConfirmationInput" PasswordChanged="OnConfirmationChanged" Margin="0,0,0,12" />

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Error}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <!-- IsDefault: Enter en cualquier caja crea la cuenta. -->
                    <Button Content="{DynamicResource register.title}" Command="{Binding RegisterCommand}" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Padding="0,9" />

                    <TextBlock Text="{DynamicResource login.connecting}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Enlace debajo de la tarjeta, como la web y Android. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource register.haveAccount}" Style="{StaticResource MutedText}" Margin="0,0,6,0" />
                <Button Content="{DynamicResource login.submit}" Command="{Binding GoToSignInCommand}"
                        Style="{StaticResource LinkButton}" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
