<!-- Confirmacion propia, en lugar del MessageBox de Windows: el MessageBox no
     sigue el tema de la aplicacion y sus botones "Sí/No" salen en el idioma
     de Windows, no en el de la aplicacion. -->
<Window x:Class="FinanceTracker.Desktop.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}">

    <!-- Sin barra de titulo de Windows, como la ventana principal. Los 48 de
         arriba se siguen pudiendo arrastrar para mover el dialogo. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="24">
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <!-- Aviso: circulo rojo con "!" dibujado, sin iconos del sistema. -->
                <Grid Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top">
                    <Ellipse Fill="{DynamicResource Brush.Danger}" Opacity="0.15" />
                    <Path Stroke="{DynamicResource Brush.Error}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M0,0 L0,7 M0,11 L0,11.01" />
                </Grid>
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock x:Name="MessageText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Margin="44,0,0,24" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- IsCancel: Escape o este boton cierran sin confirmar. Empieza con
                     el foco, para que un Enter despistado no borre nada. -->
                <Button x:Name="CancelButton" Content="{DynamicResource dialog.cancel}" IsCancel="True"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerPrimaryButton}" Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
