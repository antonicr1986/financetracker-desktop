<Window x:Class="FinanceTracker.Desktop.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.Desktop.ViewModels"
        xmlns:views="clr-namespace:FinanceTracker.Desktop.Views"
        xmlns:controls="clr-namespace:FinanceTracker.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ForgotPasswordViewModel}"
        Title="{DynamicResource passwordReset.windowTitle}"
        Width="540" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}">

    <!-- Una sola barra, como el login y el registro: la TopBar hace de barra de titulo. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <DockPanel>
        <views:TopBar DockPanel.Dock="Top" />

        <StackPanel Margin="24">
            <TextBlock Text="{DynamicResource passwordReset.title}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- Paso 1: el correo. -->
            <Border Style="{StaticResource Card}" Padding="24"
                    Visibility="{Binding IsEmailStep, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource passwordReset.intro}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,0,0,16" />
                    <TextBlock Text="{DynamicResource login.email}" Margin="0,0,0,4" />
                    <TextBox x:Name="EmailInput" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"
                             controls:Hint.Text="{DynamicResource login.emailPlaceholder}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Error}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button Command="{Binding SendCodeCommand}" IsDefault="{Binding IsEmailStep}" Padding="0,9">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="{DynamicResource passwordReset.send}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource passwordReset.sending}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Paso 2: el codigo y la contraseña nueva. -->
            <Border Style="{StaticResource Card}" Padding="24"
                    Visibility="{Binding IsCodeStep, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <!-- Las cuentas de Google no tienen contraseña: nunca les llega el codigo. -->
                    <TextBlock Text="{DynamicResource passwordReset.googleHint}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" />
                    <TextBlock Text="{DynamicResource mfa.loginCode}" Margin="0,0,0,4" />
                    <TextBox x:Name="CodeInput" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="6" FontFamily="Consolas" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource passwordReset.newPassword}" Margin="0,0,0,4" />
                    <controls:RevealPasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged"
                                                HintText="{DynamicResource register.passwordPlaceholder}" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource register.confirm}" Margin="0,0,0,4" />
                    <controls:RevealPasswordBox x:Name="ConfirmationInput" PasswordChanged="OnConfirmationChanged" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Error}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button Command="{Binding ResetCommand}" IsDefault="{Binding IsCodeStep}" Padding="0,9">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="{DynamicResource passwordReset.submit}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource passwordReset.submitting}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{DynamicResource emailVerification.resend}" Command="{Binding ResendCodeCommand}"
                            Style="{StaticResource LinkButton}" Foreground="{DynamicResource Brush.Text}"
                            HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <Button Content="{DynamicResource mfa.back}" Command="{Binding BackToEmailCommand}"
                            Padding="0,9" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Hecho: se han cerrado todas las sesiones y se entra con la contraseña nueva. -->
            <Border Style="{StaticResource Card}" Padding="24"
                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource passwordReset.done}" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <Button Content="{DynamicResource passwordReset.goToLogin}" Command="{Binding GoToSignInCommand}"
                            IsDefault="{Binding IsDone}" Style="{StaticResource PrimaryButton}" Padding="0,9" />
                </StackPanel>
            </Border>

            <Button Content="{DynamicResource passwordReset.goToLogin}" Command="{Binding GoToSignInCommand}"
                    Style="{StaticResource LinkButton}" Foreground="{DynamicResource Brush.Text}"
                    HorizontalAlignment="Center" Margin="0,16,0,0"
                    Visibility="{Binding ShowSignInLink, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </DockPanel>
</Window>
