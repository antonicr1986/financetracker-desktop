<Window x:Class="FinanceTracker.Desktop.Views.MfaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FinanceTracker.Desktop.ViewModels"
        xmlns:controls="clr-namespace:FinanceTracker.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MfaViewModel}"
        Title="{DynamicResource mfa.title}" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.Text}">

    <!-- Misma barra que los formularios: la fila del titulo se arrastra y lleva la X. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <controls:QrCodeConverter x:Key="QrCode" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <StackPanel>
            <DockPanel Height="64">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseCaptionButton}" VerticalAlignment="Top"
                        Height="40" Content="&#xE8BB;" Click="OnCloseClick" />
                <TextBlock Text="{DynamicResource mfa.title}" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Bottom" Margin="24,0,0,4" />
            </DockPanel>

            <StackPanel Margin="24,12,24,24">
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource mfa.description}" Style="{StaticResource MutedText}"
                           TextWrapping="Wrap" Margin="0,4,0,16" />

                <Button Content="{Binding ActionText}" Command="{Binding StartCommand}" Padding="0,9"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />

                <!-- Equipos donde se marco "no volver a pedir el codigo". -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding ShowDevices, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource mfa.forgetDevicesHelp}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="{DynamicResource mfa.forgetDevices}" Command="{Binding ForgetDevicesCommand}"
                            Padding="0,9" />
                    <TextBlock Text="{Binding DevicesMessage}" Foreground="{DynamicResource Brush.Income}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Activar: QR + clave + primer codigo. -->
                <StackPanel Visibility="{Binding IsSetup, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource mfa.scan}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Border Background="White" Padding="8" HorizontalAlignment="Center" CornerRadius="8">
                        <Image Source="{Binding OtpAuthUri, Converter={StaticResource QrCode}}"
                               Width="200" Height="200" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Text="{DynamicResource mfa.manual}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,12,0,4" />
                    <!-- TextBox de solo lectura: se puede seleccionar y copiar. -->
                    <TextBox Text="{Binding Secret, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                             TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource mfa.codeLabel}" Margin="0,0,0,4" />
                    <TextBox x:Name="SetupCodeInput" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="6" FontFamily="Consolas" Margin="0,0,0,12" />
                    <Button Content="{DynamicResource mfa.confirm}" Command="{Binding ConfirmCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="0,9" />
                    <Button Content="{DynamicResource mfa.cancel}" Command="{Binding BackToIdleCommand}"
                            Padding="0,9" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Desactivar: pide un codigo actual. -->
                <StackPanel Visibility="{Binding IsDisabling, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource mfa.disableHelp}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource mfa.codeLabel}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="6" FontFamily="Consolas" Margin="0,0,0,12" />
                    <Button Content="{DynamicResource mfa.disable}" Command="{Binding DisableCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="0,9" />
                    <Button Content="{DynamicResource mfa.cancel}" Command="{Binding BackToIdleCommand}"
                            Padding="0,9" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Codigos de recuperacion: solo se ven esta vez. -->
                <StackPanel Visibility="{Binding IsShowingCodes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{DynamicResource mfa.recoveryTitle}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource mfa.recoveryBody}" Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" Margin="0,4,0,8" />
                    <TextBox Text="{Binding RecoveryCodes, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                             AcceptsReturn="True" Margin="0,0,0,12" />
                    <Button Content="{DynamicResource mfa.recoveryDone}" Command="{Binding BackToIdleCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="0,9" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Error}"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
