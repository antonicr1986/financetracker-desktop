<!-- Tema claro. Mismas claves que Dark.xaml: al cambiar de tema se sustituye
     este diccionario por el otro, y todo lo que use {DynamicResource ...}
     se repinta solo. Colores de la escala slate de Tailwind, como la web. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.Background" Color="#E2E8F0" />      <!-- slate-200 -->
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E2E8F0" />          <!-- slate-200 -->
    <SolidColorBrush x:Key="Brush.Text" Color="#0F172A" />            <!-- slate-900 -->
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#64748B" />       <!-- slate-500 -->
    <SolidColorBrush x:Key="Brush.Placeholder" Color="#94A3B8" />     <!-- slate-400 -->
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#CBD5E1" />     <!-- slate-300 -->
    <SolidColorBrush x:Key="Brush.InputFocus" Color="#64748B" />      <!-- slate-500 -->
    <SolidColorBrush x:Key="Brush.Hover" Color="#F1F5F9" />           <!-- slate-100 -->
    <SolidColorBrush x:Key="Brush.Selected" Color="#E2E8F0" />        <!-- slate-200 -->
    <SolidColorBrush x:Key="Brush.Primary" Color="#0F172A" />         <!-- slate-900 -->
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#334155" />    <!-- slate-700 -->
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#CBD5E1" />     <!-- slate-300 -->
    <SolidColorBrush x:Key="Brush.Income" Color="#047857" />          <!-- emerald-700 -->
    <SolidColorBrush x:Key="Brush.Expense" Color="#BE123C" />         <!-- rose-700 -->
    <SolidColorBrush x:Key="Brush.Error" Color="#E11D48" />           <!-- rose-600 -->

    <!-- Como en la web: luna en tema claro (pasar a oscuro), sol en oscuro. -->
    <Visibility x:Key="Visibility.Moon">Visible</Visibility>
    <Visibility x:Key="Visibility.Sun">Collapsed</Visibility>
</ResourceDictionary>
