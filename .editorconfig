# Formato comun del codigo. "dotnet format" lo aplica y el CI lo comprueba.
root = true

[*]
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml}]
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,slnx}]
indent_size = 2

# Novedades de la Store: en UTF-8 o las tildes llegan rotas.
[store/whats-new/*.txt]
charset = utf-8
